      "id": "other-dr-ranking",
      "title": "工业磨机与 EV 都存在局部动作价值差误判",
      "queries": [
        {
          "id": "effective-one-kw",
          "source": {
            "label": "同一 Dueling 第 1900 回合模型的固定回放",
            "files": [
              {
                "label": "counterfactual_probes.csv"
              },
              {
                "label": "audit_summary.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "反向判断",
                "definition": "候选动作相对原动作的预测 Q 差与确定性闭环累计奖励差异号。"
              }
            ],
            "filters": [
              "实际执行功率变化为 ±1 kW，容差 1e-5 kW",
              "累计奖励差绝对值超过 0.001",
              "每设备每月四类可控状态，共 48 个状态"
            ],
            "caveats": [
              "这是中途模型的分层诊断样本，不能外推总体误判率或最终训练效果。",
              "反事实后续动作由固定参数的确定性在线策略重新决策；TD3 训练目标含目标平滑。",
              "无可控范围的 EV 状态和同有效功率的重复候选已剔除。"
            ]
          },
          "rows": [
            {
              "设备": "工业磨机",
              "可控抽样状态": 48,
              "有明确收益差比较": 26,
              "Q1反向判断": 6,
              "双Q同时反向判断": 2
            },
            {
              "设备": "电动车",
              "可控抽样状态": 48,
              "有明确收益差比较": 15,
              "Q1反向判断": 8,
              "双Q同时反向判断": 8
            }
          ],
          "columns": [
            "设备",
            "可控抽样状态",
            "有明确收益差比较",
            "Q1反向判断",
            "双Q同时反向判断"
          ],
          "methods": [
            {
              "language": "python",
              "code": "local = group[np.isclose(abs(group.power_delta_kw), 1, atol=1e-5, rtol=0)]\nmeaningful = local[local.gain.abs() > .001]\nq1_wrong = int(sum(meaningful.dq1 * meaningful.gain < 0))\nboth_wrong = int(sum((meaningful.dq1 * meaningful.gain < 0) & (meaningful.dq2 * meaningful.gain < 0)))"
            }
          ]
        }
      ]
    },
    {
