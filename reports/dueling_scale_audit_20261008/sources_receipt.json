{
  "schemaVersion": 1,
  "items": [
    {
      "id": "dueling-scale",
      "title": "优势项相对 V 小，但不等于动作信号消失",
      "queries": [
        {
          "id": "policy-decomposition",
          "source": {
            "label": "Dueling 第 1900 回合固定模型分解",
            "files": [
              {
                "label": "baseline_decomposition.csv"
              },
              {
                "label": "critic.py"
              }
            ],
            "metricDefinitions": [
              {
                "label": "优势项",
                "definition": "完整联合有效动作相对零联合有效动作的中心化优势，A=f(s,a)-f(s,0)。"
              },
              {
                "label": "A/V比例",
                "definition": "策略轨迹上平均绝对 A 除以平均绝对 V。"
              }
            ],
            "filters": [
              "55 个测试日，每设备 1320 小时",
              "Q1，策略动作噪声为零"
            ],
            "caveats": [
              "这里的 V 是零有效联合动作基线，未必可行，也不是策略平均状态价值。",
              "优势项包括所有联合动作通道，不能当作单个 DR 的贡献率。",
              "固定模型来自第 1900 回合，不代表最终模型。"
            ]
          },
          "rows": [
            {
              "设备": "磨机",
              "平均绝对V": 4.549456957270476,
              "平均绝对A": 0.17655362026257948,
              "A_V比例": 0.03880762515632323
            },
            {
              "设备": "HVAC",
              "平均绝对V": 4.716887650164691,
              "平均绝对A": 0.1811626349208933,
              "A_V比例": 0.03840723976424751
            },
            {
              "设备": "EV",
              "平均绝对V": 4.650570151280386,
              "平均绝对A": 0.16303613324734295,
              "A_V比例": 0.03505723555260341
            }
          ],
          "columns": [
            "设备",
            "平均绝对V",
            "平均绝对A",
            "A_V比例"
          ],
          "evidenceFlow": [
            {
              "kind": "validation",
              "title": "梯度检查",
              "text": "3960 个小时/设备记录上 dQ/da 与 dA/da 的最大绝对差为零。"
            }
          ]
        }
      ]
    },
    {
      "id": "dueling-delta-error",
      "title": "局部动作收益差预测幅度没有普遍缩小，误差大于真实小收益",
      "queries": [
        {
          "id": "one-kw-deltas",
          "source": {
            "label": "三类 DR 的同状态反事实比较",
            "files": [
              {
                "label": "candidate_decomposition.csv"
              },
              {
                "label": "audit_summary.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "局部收益差",
                "definition": "只改变当前一次 DR 有效执行功率 ±1 kW，后续由固定在线策略运行至当天结束所得累计团队奖励差。"
              }
            ],
            "filters": [
              "每设备 48 个分层状态",
              "仅实际功率差为 ±1 kW 的比较，容差 1e-5 kW",
              "幅度中位数包括局部比较中所有收益差，未作 0.001 显著性过滤"
            ],
            "caveats": [
              "两个中位数之比不是逐比较倍率的中位数，也不是信噪比。",
              "确定性真实回放与 TD3 平滑训练目标有差异，误差不能全部归因于随机噪声。",
              "抽样比较不能外推总体误判率；没有训练消融来确认 V 主导是原因。"
            ]
          },
          "rows": [
            {
              "设备": "磨机",
              "局部比较": 50,
              "真实差中位数": 0.0013179647946543502,
              "预测差中位数": 0.0040289163589477,
              "误差中位数": 0.0036403909671058497,
              "预测_真实中位数比": 3.056922594054817
            },
            {
              "设备": "HVAC",
              "局部比较": 95,
              "真实差中位数": 0.0012369501821853,
              "预测差中位数": 0.0029600858688354,
              "误差中位数": 0.0033585033414332,
              "预测_真实中位数比": 2.393051807151897
            },
            {
              "设备": "EV",
              "局部比较": 48,
              "真实差中位数": 0.00026200172237354996,
              "预测差中位数": 0.00470936298370355,
              "误差中位数": 0.004975044444212861,
              "预测_真实中位数比": 17.97454971303264
            }
          ],
          "columns": [
            "设备",
            "局部比较",
            "真实差中位数",
            "预测差中位数",
            "误差中位数",
            "预测_真实中位数比"
          ],
          "evidenceFlow": [
            {
              "kind": "validation",
              "title": "浮点分解检查",
              "text": "1232 个候选记录上 Q 差与优势差的最大差为 4.77e-6；原始 Q 差复现最大差为 7.63e-6。"
            },
            {
              "kind": "validation",
              "title": "独立重算",
              "text": "直接从 CSV 重算均值、中位数及方向错误次数，与汇总一致。"
            }
          ]
        }
      ]
    }
  ]
}