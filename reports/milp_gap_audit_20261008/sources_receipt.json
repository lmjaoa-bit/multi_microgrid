    {
      "id": "interface-and-clearing",
      "title": "Aggregate EV control limits exact replay, while allocation alone contributes little cost",
      "queries": [
        {
          "id": "compatibility",
          "source": {
            "label": "Power-curve compatibility and fixed-control allocation comparison",
            "files": [
              {
                "label": "environment_replay_results.csv"
              },
              {
                "label": "fixed_dispatch_results.csv"
              },
              {
                "label": "optimization/common_constraints.py"
              },
              {
                "label": "components/ev_charging.py"
              },
              {
                "label": "evaluation/evaluate_matd3.py"
              }
            ],
            "metricDefinitions": [
              {
                "label": "EV curve mismatch",
                "definition": "MILP chooses cohort-specific charging; the environment maps one aggregate charging request using its urgency-based cohort allocation."
              },
              {
                "label": "Allocation-only gap",
                "definition": "Policy cost minus MILP cost with all executed ESS and DR power curves held fixed."
              }
            ],
            "caveats": [
              "The existing formal oracle_replay field compares policy and oracle trajectories; it does not replay the same oracle controls.",
              "Different individual microgrid flows can coexist with nearly identical team generalized costs."
            ]
          },
          "rows": [
            {
              "metric": "Maximum EV-only replay power mismatch (kW)",
              "value": 18.293170406520552
            },
            {
              "metric": "Maximum allocation-only cost gap magnitude",
              "value": 0.00012766546990405914
            }
          ],
          "columns": [
            "metric",
            "value"
          ]
        }
      ]
    },
