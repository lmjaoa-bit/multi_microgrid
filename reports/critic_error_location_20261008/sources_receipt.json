{
  "schemaVersion": 1,
  "items": [
    {
      "id": "terminal-critic-error",
      "title": "HVAC 的终止时段即时动作收益排序存在错误",
      "queries": [
        {
          "id": "terminal-pairs",
          "source": {
            "label": "第 4600 回合最佳模型的终止对比",
            "files": [
              {
                "label": "latest/pair_decomposition.csv"
              },
              {
                "label": "training_date_terminal_pairs.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "反向判断",
                "definition": "同状态候选相对原动作的 Q 差与实际奖励差异号。"
              }
            ],
            "filters": [
              "第 23 小时，执行当前动作后结束，无后续价值",
              "仅有效执行功率差为 ±1 kW 的比较",
              "实际奖励差绝对值大于 0.001"
            ],
            "caveats": [
              "训练日期上的状态由最终最佳策略重新生成，不是保存的训练 replay。",
              "这些比例来自限定的轨迹和候选，不是整个训练分布的误判率。",
              "终止时段排除了当前备份中的平滑和滞后项，未排除它们在历史训练中的间接影响。"
            ]
          },
          "rows": [
            {
              "日期来源": "测试日期",
              "设备": "mg2",
              "明确比较": 70,
              "Q1反向": 37,
              "Q2反向": 16
            },
            {
              "日期来源": "训练日期重新生成状态",
              "设备": "mg2",
              "明确比较": 60,
              "Q1反向": 29,
              "Q2反向": 13
            }
          ],
          "columns": [
            "日期来源",
            "设备",
            "明确比较",
            "Q1反向",
            "Q2反向"
          ],
          "evidenceFlow": [
            {
              "kind": "validation",
              "title": "终止边界",
              "text": "训练目标含正确的 done 掩码；此时 Q 的目标仅为当前奖励。测试 37 次 Q1 误判中有 35 次舒适度成本不变。"
            }
          ]
        }
      ]
    },
    {
      "id": "temporal-error-location",
      "title": "HVAC 当前差值拟合最突出，EV 当前与后续均存在差值误差",
      "queries": [
        {
          "id": "residual-decomposition",
          "source": {
            "label": "最新模型的逐小时 Bellman 残差对比",
            "files": [
              {
                "label": "latest/hourly_error_contributions.csv"
              },
              {
                "label": "latest/pair_decomposition.csv"
              }
            ],
            "metricDefinitions": [
              {
                "label": "当前残差差",
                "definition": "候选与原动作当前一步 Q-r-Qnext 残差之差。"
              },
              {
                "label": "后续残差差",
                "definition": "两条固定在线策略分支后续各小时残差之差的总和。"
              }
            ],
            "filters": [
              "每设备先前选出的 48 个日期/小时，按最新策略重新形成状态",
              "有效执行功率差为 ±1 kW",
              "收益差绝对值大于 0.001",
              "残差中位数只在 Q1 反向判断样本内计算"
            ],
            "caveats": [
              "这是代数分解，不能证明容量、训练覆盖或优化过程中的某一项是原因。",
              "重建目标不是当时 replay 中实际使用的训练目标。"
            ]
          },
          "rows": [
            {
              "设备": "mg1",
              "明确比较": 26,
              "Q1反向": 4,
              "当前残差差中位数": 0.0052685284402116,
              "后续残差差中位数": 0.0063306756147143
            },
            {
              "设备": "mg2",
              "明确比较": 48,
              "Q1反向": 29,
              "当前残差差中位数": 0.0078146601786432,
              "后续残差差中位数": 0.0003883112490099
            },
            {
              "设备": "mg3",
              "明确比较": 18,
              "Q1反向": 10,
              "当前残差差中位数": 0.00714794990771285,
              "后续残差差中位数": 0.0060476890439487
            }
          ],
          "columns": [
            "设备",
            "明确比较",
            "Q1反向",
            "当前残差差中位数",
            "后续残差差中位数"
          ],
          "evidenceFlow": [
            {
              "kind": "validation",
              "title": "独立重算",
              "text": "CSV 逐小时残差差求和与预测差减实际回报差一致，最大代数误差低于 1e-10。"
            }
          ]
        }
      ]
    },
    {
      "id": "policy-objective-check",
      "title": "部分 HVAC/EV 反向例在持续平滑目标策略下仍然成立",
      "queries": [
        {
          "id": "matched-policy-rollouts",
          "source": {
            "label": "四例目标策略持续平滑回放",
            "files": [
              {
                "label": "policy_objective_rollouts.csv"
              },
              {
                "label": "policy_objective_summary.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "持续平滑收益差",
                "definition": "只改变第一步 DR，后续每一步使用固定目标 Actor 加标准差 0.2、裁剪 0.5 的扰动，两分支采用共同随机数。"
              }
            ],
            "filters": [
              "第 4600 回合最佳模型",
              "每例 64 对仿真回放",
              "四个刻意选择的反向例"
            ],
            "caveats": [
              "Monte Carlo 区间只衡量固定场景下抽样误差，不能衡量模型泛化不确定性。",
              "双 Q 最小值备份并非一个真实物理策略，不能宣称完全复制训练目标。",
              "磨机例的区间跨零，目标差异可能解释部分差值。"
            ]
          },
          "rows": [
            {
              "设备": "mg1",
              "日期": "2018-01-29",
              "小时": 5,
              "在线收益差": 0.0053351975458504,
              "持续平滑收益差均值": 0.0005425935468350435,
              "MonteCarlo区间下界": -0.0007020612734009403,
              "Q1预测差": -0.0053553581237792
            },
            {
              "设备": "mg2",
              "日期": "2018-11-26",
              "小时": 8,
              "在线收益差": 0.0072924418602049,
              "持续平滑收益差均值": 0.0051438272195872825,
              "MonteCarlo区间下界": 0.0042420959058537076,
              "Q1预测差": -0.006988525390625
            },
            {
              "设备": "mg3",
              "日期": "2018-01-30",
              "小时": 9,
              "在线收益差": 0.0129426197406008,
              "持续平滑收益差均值": 0.012121258396405599,
              "MonteCarlo区间下界": 0.011435766130722148,
              "Q1预测差": -0.0090799331665039
            },
            {
              "设备": "mg3",
              "日期": "2018-03-31",
              "小时": 1,
              "在线收益差": 0.0637413486522939,
              "持续平滑收益差均值": 0.06679137669359705,
              "MonteCarlo区间下界": 0.06570098682913773,
              "Q1预测差": -0.05295991897583
            }
          ],
          "columns": [
            "设备",
            "日期",
            "小时",
            "在线收益差",
            "持续平滑收益差均值",
            "MonteCarlo区间下界",
            "Q1预测差"
          ]
        }
      ]
    },
    {
      "id": "ev-action-coverage",
      "title": "EV 训练原始动作范围偏集中，但缺少 replay 不能确定条件覆盖的因果作用",
      "queries": [
        {
          "id": "training-action-extrema",
          "source": {
            "label": "最佳模型之前的训练动作日志",
            "files": [
              {
                "label": "training_history.json"
              },
              {
                "label": "training_date_checks.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "全天动作大于0.5",
                "definition": "回合记录中 EV 原始 DR 动作的最小值大于 0.5，日志包含探索噪声和强制小时。"
              }
            ],
            "filters": [
              "训练第 4300–4600 回合，共 301 个回合"
            ],
            "caveats": [
              "每日极值不是可控状态中完整的条件动作分布。",
              "局部 ±1 kW 候选仍可能位于已有探索范围，不能仅凭动作集中解释全部误判。",
              "没有保存 replay 或 optimizer 更新历史，不能区分覆盖、表达与优化的影响。"
            ]
          },
          "rows": [
            {
              "训练回合数": 301,
              "全天动作大于0.5的回合数": 246,
              "日均原始动作的中位数": 0.9360363408923149
            }
          ],
          "columns": [
            "训练回合数",
            "全天动作大于0.5的回合数",
            "日均原始动作的中位数"
          ]
        }
      ]
    }
  ]
}